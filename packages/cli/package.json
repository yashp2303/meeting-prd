{
  "name": "@meeting-prd/cli",
  "version": "0.1.5",
  "type": "module",
  "bin": {
    "meeting-prd": "./dist/meeting-prd.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/meeting-prd.js --banner:js='#!/usr/bin/env node' --packages=bundle && chmod +x dist/meeting-prd.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@meeting-prd/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
