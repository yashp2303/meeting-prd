# ---------------------------------------------------------------------------
# meeting-prd configuration
# Copy to .env.local (web) or run `meeting-prd init` to generate ~/.meeting-prd/config.json
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Groq (PRD generation) -------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified available on Groq: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.6-27b, groq/compound
GROQ_MODEL=openai/gpt-oss-120b

# Groq meters tokens-per-minute against prompt + reserved completion budget,
# not actual usage — so an over-large budget fails requests that would have fit.
# Free tier is 8000 TPM. Raise both if you are on a paid tier; a bigger
# completion budget lets the model write longer PRDs before truncating.
GROQ_MAX_TOKENS=6000
GROQ_TPM_LIMIT=8000

# --- Vexa (Google Meet bot + transcripts) ----------------------------------
VEXA_API_KEY=
# Hosted: https://api.cloud.vexa.ai   Self-hosted: http://localhost:18056
VEXA_BASE_URL=https://api.cloud.vexa.ai
VEXA_BOT_NAME=PRD Bot
VEXA_LANGUAGE=en

# --- Google Calendar (meeting discovery) -----------------------------------
# Create an OAuth 2.0 Desktop client at console.cloud.google.com,
# then run `meeting-prd google:auth` to mint the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Slack (approval message) ----------------------------------------------
# Incoming webhook. Approve/Reject are signed magic links, so no Slack app needed.
SLACK_WEBHOOK_URL=

# --- ClickUp (ticket creation) ---------------------------------------------
# Personal token from ClickUp > Settings > Apps. Starts with pk_
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=90161443777
# Run `meeting-prd clickup:discover` to find this
CLICKUP_LIST_ID=

# --- App ------------------------------------------------------------------
# Public URL of the deployed web app. Slack links point here.
APP_BASE_URL=http://localhost:3000
# HMAC key for signing approve/reject links. Generate: openssl rand -hex 32
APPROVAL_SECRET=
# Bearer token protecting /api/cron/tick. Generate: openssl rand -hex 32
CRON_SECRET=

# Minutes ahead of start time to dispatch the bot
LOOKAHEAD_MINUTES=10
# Minutes of transcript silence before a meeting is treated as ended
IDLE_TIMEOUT_MINUTES=5
# Set to "1" to skip Slack approval and publish straight to ClickUp
AUTO_APPROVE=0

# --- Storage (optional) ----------------------------------------------------
# Without these the app uses a file store locally, memory on serverless.
# For Vercel, add an Upstash Redis integration and these are injected for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
